#!/usr/bin/env sh
# Quick checks to catch issues early before spending CI time.
# Bypass a one-off with `git push --no-verify`.
#
# Generated README surfaces are deliberately not checked here. They are release
# artifacts the pipeline regenerates, not work every push has to prepare.
# @see kb/01a03c27-918e-737a-b288-1b27a6c2ddca.md
set -e

if ! git diff --quiet || ! git diff --cached --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
	echo "pre-push: working tree is dirty; commit or stash changes before pushing."
	git status --short
	exit 1
fi

# Sign-off first, because it is instant and the fix is a rebase -- finding out
# from CI costs a round trip to learn something git knew before the push left.
# Git feeds this hook one `<local ref> <local sha> <remote ref> <remote sha>`
# line per ref being pushed; a zero remote sha means the remote has no such
# branch, so the refs every remote already holds bound the range instead.
ZERO=0000000000000000000000000000000000000000
echo "pre-push: sign-off check"
while read -r _local_ref local_sha _remote_ref remote_sha; do
	if [ "$local_sha" = "$ZERO" ]; then continue; fi
	if [ "$remote_sha" = "$ZERO" ]; then
		node scripts/check-signoff.mjs "$local_sha" --not --remotes
	else
		node scripts/check-signoff.mjs "$remote_sha..$local_sha"
	fi
done

echo "pre-push: format check + typecheck + build + test"
npm run format:check
npm run typecheck
npm run build
npm test
npm run test:pack-bin

#!/usr/bin/env sh
# Early gate mirroring the publish workflow. Runs on `git push`.
# Bypass a one-off with `git push --no-verify`.
#
# Generated README surfaces are deliberately not checked here. They are release
# artifacts the pipeline regenerates, not work every push has to prepare.
set -e

if ! git diff --quiet || ! git diff --cached --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
	echo "pre-push: working tree is dirty; commit or stash changes before pushing."
	git status --short
	exit 1
fi

echo "pre-push: format check + typecheck + build + test"
npm run format:check
npm run typecheck
npm run build
npm test
npm run test:pack-bin

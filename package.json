{
	"name": "nosedive",
	"version": "2026.8.27-1787841579062",
	"description": "Turns a plain notes repo into a hub for cross-repo work.",
	"keywords": [
		"cli",
		"agentic",
		"workflow",
		"multi-repo",
		"polyrepo",
		"monorepo"
	],
	"license": "MIT",
	"author": "Dan Stace <dstace@gmail.com>",
	"funding": "https://ko-fi.com/sycdan",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sycdan/nosedive.git"
	},
	"type": "module",
	"bin": {
		"nosedive": "dist/cli.js"
	},
	"files": [
		"dist",
		"kb",
		".nosedive-ref"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"commands:surface": "node scripts/update-readme-command-surface.mjs",
		"faq:surface": "node scripts/update-readme-faq.mjs",
		"commands:identifiers": "node scripts/command-identifiers.mjs",
		"check:command-surface": "node scripts/update-readme-command-surface.mjs --check",
		"check:faq-surface": "node scripts/update-readme-faq.mjs --check",
		"build": "tsup src/cli.ts src/nosedive.ts --format esm --target node22 --clean",
		"format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.mjs\" \"package.json\" \"tsconfig.json\" \".github/workflows/*.yml\" \".prettierrc.json\"",
		"format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.mjs\" \"package.json\" \"tsconfig.json\" \".github/workflows/*.yml\" \".prettierrc.json\"",
		"typecheck": "tsc",
		"check:release-surface": "node scripts/check-release-surface.mjs",
		"test": "npm run format:check && npm run check:release-surface && node --test \"scripts/test/*.mjs\"",
		"test:pack-bin": "node scripts/test-pack-bin.mjs",
		"prepack": "npm run build",
		"prepare": "git config core.hooksPath .githooks"
	},
	"devDependencies": {
		"@types/node": "^26.1.0",
		"prettier": "3.9.6",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"yaml": "^2.9.0"
	}
}
